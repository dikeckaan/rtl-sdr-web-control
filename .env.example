# ============================================
# SDR Station - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Station Info ---
STATION_NAME=my-sdr-station
STATION_LAT=40.00000
STATION_LON=29.00000
STATION_ALT=50m

# --- Cloudflare Tunnel ---
CLOUDFLARED_TOKEN=your_cloudflare_tunnel_token_here

# --- FlightAware (PiAware) ---
PIAWARE_FEEDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Flightradar24 ---
FR24_KEY=your_fr24_sharing_key

# --- MLAT ---
MLAT_USER=your_username

# --- Flask Switcher ---
FLASK_SECRET_KEY=change-me-to-a-random-string

# --- ShinySDR ---
SHINYSDR_ROOT_CAP=change-me-to-random-token
